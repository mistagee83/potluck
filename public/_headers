# Cloudflare Pages headers. The landing page is indexed; the app pages and the developer tools are not.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/teacher.html
  X-Robots-Tag: noindex
/join.html
  X-Robots-Tag: noindex
/exhibit.html
  X-Robots-Tag: noindex
/dev/*
  X-Robots-Tag: noindex

/*.html
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
